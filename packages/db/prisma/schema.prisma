// PulseOps - schema inicial (Prisma 7 / PostgreSQL 18).
// A URL de conexão NÃO fica aqui: vem de prisma.config.ts (variável DATABASE_URL).
// Nenhuma migração foi executada. Ver docs/DATABASE.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum HttpMethod {
  GET
  HEAD
}

enum CheckStatus {
  UP
  DOWN
  TIMEOUT
  ERROR
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum AlertChannel {
  EMAIL
  WEBHOOK
}

enum NotificationEvent {
  INCIDENT_OPENED
  INCIDENT_RESOLVED
  TEST
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum WorkerTaskStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  emailVerified Boolean   @default(false) @map("email_verified")
  disabledAt    DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership Membership? // uma organização por conta
  sessions   Session[]
  incidentUpdates IncidentUpdate[]
  auditLogs  AuditLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships  Membership[]
  invitations  Invitation[]
  monitors     Monitor[]
  incidents    Incident[]
  alertRules   AlertRule[]
  notifications Notification[]
  statusPages  StatusPage[]
  auditLogs    AuditLog[]
  workerTasks  WorkerTask[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid // unique => uma organização por usuário
  organizationId String   @map("organization_id") @db.Uuid
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, role])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String   
  role           Role      @default(MEMBER)
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("invitations")
}

model Session {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid // rotação de refresh token
  refreshHash String    @unique @map("refresh_hash")
  userAgent   String?   @map("user_agent")
  ip          String?
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model Monitor {
  id             String     @id @default(uuid(7)) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  url            String
  method         HttpMethod @default(GET)
  intervalSec    Int        @default(300) @map("interval_sec") // padrão: 5 minutos
  timeoutMs      Int        @default(10000) @map("timeout_ms")
  expectedStatus Int        @default(200) @map("expected_status")
  failureThreshold Int      @default(2) @map("failure_threshold")
  enabled        Boolean    @default(true)
  nextRunAt      DateTime   @default(now()) @map("next_run_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checks         MonitorCheck[]
  incidents      Incident[]
  alertRules     AlertRule[]
  statusPages    StatusPageMonitor[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([enabled, nextRunAt])
  @@map("monitors")
}

model MonitorCheck {
  id             String      @id @default(uuid(7)) @db.Uuid
  monitorId      String      @map("monitor_id") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  status         CheckStatus
  httpStatus     Int?        @map("http_status")
  latencyMs      Int?        @map("latency_ms")
  error          String?
  checkedAt      DateTime    @default(now()) @map("checked_at") @db.Timestamptz(6)
  // Retenção de 30 dias: o job de limpeza remove linhas com expires_at < now().
  expiresAt      DateTime    @default(dbgenerated("(now() + interval '30 days')")) @map("expires_at") @db.Timestamptz(6)

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@index([organizationId, checkedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("monitor_checks")
}

model Incident {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  monitorId      String?          @map("monitor_id") @db.Uuid
  title          String
  status         IncidentStatus   @default(INVESTIGATING)
  severity       IncidentSeverity @default(MAJOR)
  startedAt      DateTime         @default(now()) @map("started_at") @db.Timestamptz(6)
  resolvedAt     DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitor       Monitor?         @relation(fields: [monitorId], references: [id], onDelete: SetNull)
  updates       IncidentUpdate[]
  notifications Notification[]

  // Pendente (SQL manual na migração): índice único parcial garantindo
  // no máximo 1 incidente aberto por monitor (WHERE resolved_at IS NULL).
  @@index([organizationId, status])
  @@index([monitorId, startedAt(sort: Desc)])
  @@map("incidents")
}

model IncidentUpdate {
  id         String         @id @default(uuid(7)) @db.Uuid
  incidentId String         @map("incident_id") @db.Uuid
  authorId   String?        @map("author_id") @db.Uuid
  status     IncidentStatus
  message    String
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_updates")
}

model AlertRule {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @default("")
  monitorId      String?      @map("monitor_id") @db.Uuid // nulo = todos os monitores
  channel        AlertChannel
  target         String // e-mail ou URL (segredos devem ser cifrados na aplicação)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitor       Monitor?       @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([organizationId])
  @@index([monitorId])
  @@map("alert_rules")
}

model Notification {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  incidentId     String?            @map("incident_id") @db.Uuid
  alertRuleId    String?            @map("alert_rule_id") @db.Uuid
  event          NotificationEvent  @default(INCIDENT_OPENED)
  status         NotificationStatus @default(PENDING)
  attempts       Int                @default(0)
  lastError      String?            @map("last_error")
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  incident     Incident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  alertRule    AlertRule?   @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)

  @@unique([incidentId, alertRuleId, event])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("notifications")
}

model StatusPage {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  slug           String   @unique
  title          String
  description    String?
  isPublic       Boolean  @default(false) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  monitors     StatusPageMonitor[]

  @@index([organizationId])
  @@map("status_pages")
}

model StatusPageMonitor {
  statusPageId String @map("status_page_id") @db.Uuid
  monitorId    String @map("monitor_id") @db.Uuid
  position     Int    @default(0)
  displayName  String? @map("display_name")

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitor    Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@id([statusPageId, monitorId])
  @@index([monitorId])
  @@map("status_page_monitors")
}

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorId])
  @@map("audit_logs")
}

model WorkerTask {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  type           String
  payload        Json             @default("{}")
  status         WorkerTaskStatus @default(PENDING)
  runAt          DateTime         @default(now()) @map("run_at") @db.Timestamptz(6)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(5) @map("max_attempts")
  lockedBy       String?          @map("locked_by")
  lockedUntil    DateTime?        @map("locked_until") @db.Timestamptz(6)
  lastError      String?          @map("last_error")
  dedupeKey      String?          @unique @map("dedupe_key")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([lockedUntil])
  @@index([organizationId])
  @@map("worker_tasks")
}
