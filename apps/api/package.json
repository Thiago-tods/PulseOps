{
  "name": "@pulseops/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "npm run build && npm run start",
    "test": "jest --passWithNoTests",
    "test:e2e": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --config jest.e2e.config.js --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/throttler": "^6.8.0",
    "@pulseops/db": "^0.1.0",
    "@pulseops/http-guard": "0.1.0",
    "@pulseops/shared": "0.1.0",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15"
  }
}
