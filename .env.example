# Copie para .env (NUNCA commitar .env). Não coloque senhas reais neste arquivo.
NODE_ENV=development

# API
API_PORT=3000
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Banco (PostgreSQL 18 local, porta 5432). Preencha usuário/senha localmente.
DATABASE_URL=postgresql://USUARIO:SENHA@localhost:5432/pulseops

# Menor intervalo de monitor aceito (segundos)
MIN_MONITOR_INTERVAL_SEC=300

# Limite de monitores por organização
MAX_MONITORS_PER_ORG=20

# Autenticação (gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=troque-me-com-no-minimo-32-caracteres-aleatorios
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=5
# Modo do worker: daemon (contínuo) ou once (executa o que venceu e encerra; usado no GitHub Actions)
WORKER_MODE=daemon
# Tempo que um worker "possui" uma tarefa antes de outro poder reassumi-la
TASK_LEASE_SEC=120
SCHEDULER_BATCH_SIZE=200
CHECK_RETENTION_DAYS=30

# Frontend (Vite)
VITE_API_URL=/api/v1

# Quantos proxies confiáveis existem na frente da API (0 em desenvolvimento)
TRUST_PROXY=0
