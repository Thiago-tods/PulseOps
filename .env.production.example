# Referência das variáveis de PRODUÇÃO. Não copie para um arquivo versionado: cada valor é
# configurado no painel do serviço (Render, GitHub Secrets, Cloudflare). Sem valores reais aqui.

# ---- API (Render) ----
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=10000
LOG_LEVEL=info
# URL exata do frontend (HTTPS). Em produção a API recusa origens http/localhost.
CORS_ORIGINS=https://SEU-PROJETO.pages.dev
# Connection string do Neon. Use a conexão DIRETA (sem "-pooler") e sslmode=require.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-DO-NEON/NOME?sslmode=require
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Obrigatória em produção: cifra os webhooks no banco. Guarde uma cópia segura; sem ela os
# webhooks cadastrados não podem ser lidos. O mesmo valor vai no secret do GitHub Actions (worker).
WEBHOOK_ENCRYPTION_KEY=
DB_POOL_MAX=3
# Menor intervalo de monitor aceito. Deve ser igual à frequência real do worker (15 min no Neon gratuito).
MIN_MONITOR_INTERVAL_SEC=900
# Saltos confiáveis na frente da API, MEDIDOS no Render (acesso direto): proxy local + balanceador +
# Cloudflare = 3. Com o proxy do Cloudflare Pages na frente a cadeia muda (ver docs/DEPLOYMENT.md).
TRUST_PROXY=3
# Segredo compartilhado com o proxy do Cloudflare Pages (mínimo 32 caracteres; mesmo valor nos dois lados).
# Com ele, a API usa o IP real que o proxy envia; sem ele (acesso direto) vale o TRUST_PROXY acima.
PROXY_SHARED_SECRET=
# Diagnóstico temporário do IP do cliente (GET /api/v1/health/client). Mantenha ausente/false.
# DEBUG_CLIENT_IP=true

# ---- Frontend (Cloudflare Pages) ----
# Variáveis da Pages Function (functions/api/[[path]].ts):
API_ORIGIN=https://SEU-SERVICO.onrender.com
# Secret, IGUAL ao PROXY_SHARED_SECRET da API. Sem ele a Function recusa encaminhar (falha fechada).
PROXY_SHARED_SECRET=

# ---- Worker (GitHub Actions, secret DATABASE_URL) ----
# O restante é definido no próprio workflow (.github/workflows/worker.yml).
