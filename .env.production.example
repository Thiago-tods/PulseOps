# Referência das variáveis de PRODUÇÃO. Não copie para um arquivo versionado: cada valor é
# configurado no painel do serviço (Render, GitHub Secrets, Cloudflare). Sem valores reais aqui.

# ---- API (Render) ----
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=10000
LOG_LEVEL=info
# URL exata do frontend (HTTPS). Em produção a API recusa origens http/localhost.
CORS_ORIGINS=https://SEU-PROJETO.pages.dev
# Connection string do Neon. Use a conexão DIRETA (sem "-pooler") e sslmode=require.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST-DO-NEON/NOME?sslmode=require
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
DB_POOL_MAX=3
# Menor intervalo de monitor aceito. Deve ser igual à frequência real do worker (15 min no Neon gratuito).
MIN_MONITOR_INTERVAL_SEC=900
# Proxies confiáveis na frente da API: Render + Cloudflare = 2 (valide após o deploy).
TRUST_PROXY=2

# ---- Frontend (Cloudflare Pages) ----
# Variável usada pela Pages Function (functions/api/[[path]].ts):
API_ORIGIN=https://SEU-SERVICO.onrender.com

# ---- Worker (GitHub Actions, secret DATABASE_URL) ----
# O restante é definido no próprio workflow (.github/workflows/worker.yml).
